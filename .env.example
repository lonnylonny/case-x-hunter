# Demo 配置模板。推荐运行 scripts/start-demo.sh 或 scripts/start-demo.ps1，
# 自动生成 .env 与两份不同的随机密码；不需要宿主 Python/uv。
# .env 已忽略，请私下备份。已有数据库卷时必须保留原凭据；修改本文件不会轮换密码。
# Compose / 宿主环境变量优先于 .env；模型密钥留空也可启动与 check-only。
DEEPSEEK_API_KEY=

# 手动复制模板时，将两个占位值换成不同的随机密码。
# 容器数据库连接只使用 CASETRACE_POSTGRES_PASSWORD，内部固定 postgres:5432/casetrace。
CASETRACE_POSTGRES_ADMIN_PASSWORD=replace_with_random_admin_password
CASETRACE_POSTGRES_PASSWORD=replace_with_random_app_password
CASETRACE_POSTGRES_PORT=5432
CASETRACE_API_PORT=8000

# 以下仅供宿主 Python/uv 开发或 PostgreSQL 测试；容器启动不需要这些 URL。
# 需要时取消注释，并填写 URL 编码后的应用密码和上方映射端口。
# CASETRACE_DATABASE_URL=postgresql://casetrace:URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/casetrace
# CASETRACE_TEST_DATABASE_URL=postgresql://casetrace:URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/casetrace_test
# 旧 CASETRACE_CONTAINER_DATABASE_URL 已停用；不再需要手动同步容器 URL。
